#---- willyhorizont.github.io tint2-bottom-panel configuration ----
# https://gitlab.com/o9000/tint2/wikis/Configure
# https://gitlab.com/o9000/tint2/blob/master/doc/tint2.md

rounded = 0
border_width = 0
background_color = #ffffff 0
border_color = #ffffff 100

rounded = 0
border_width = 1
background_color = #000000 100
border_color = #FF1493 100

rounded = 0
border_width = 0
background_color = #ffffff 100
border_color = #ffffff 100

panel_items = FSEEEEEEP
panel_position = bottom right horizontal
panel_layer = top
panel_size = 100% 18
panel_shrink = 0
panel_margin = 0 0
panel_padding = 0 0
panel_background_id = 1
wm_menu = 1
strut_policy = follow_size
panel_window_name = tint2-bottom-panel

# --- S: Systray ---
systray_padding = 0 0
systray_background_id = 3
systray_sort = descending
systray_icon_size = 20
systray_icon_asb = 100 0 -80

