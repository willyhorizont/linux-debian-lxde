# --- E: Indicator Bluetooth ---
execp = new
execp_command = ~/willyhorizont.github.io/linux/bt.sh --indicator
execp_interval = 4
execp_has_icon = 0
execp_font = JetBrains Mono Bold 8
execp_font_color = #000000 100
execp_background_id = 3
execp_padding = 0 0
execp_lclick_command = lxterminal --geometry=88x28 --working-directory=~ -e ~/willyhorizont.github.io/linux/bt.sh

