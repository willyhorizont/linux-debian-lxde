# --- E: Indicator Battery ---
execp = new
execp_command = ACPI_OUT=$(acpi -b | head -n1); CAP=$(echo "$ACPI_OUT" | awk -F', ' '{print $2}' | tr -d '% '); CAP_PAD=$(printf "%3d" "$CAP"); if echo "$ACPI_OUT" | grep -F ", Charging," > /dev/null || echo "$ACPI_OUT" | grep -q "[: ]Charging,"; then if [ "$CAP" -ge 40 ]; then echo "⚡🔋 $CAP_PAD%"; else echo "⚡🪫 $CAP_PAD%"; fi; else if [ "$CAP" -ge 40 ]; then echo " 🔋 $CAP_PAD%"; else echo " 🪫 $CAP_PAD%"; fi; fi
execp_interval = 5
execp_has_icon = 0
execp_font = JetBrains Mono 8
execp_font_color = #000000 100
execp_padding = 8 0
execp_tooltip = 
execp_lclick_command = lxterminal -e ~/.config/tint2/powerprofilestui.sh

