# --- E: Indicator Bluetooth ---
execp = new
execp_command = if [ -z "$(ls /sys/class/bluetooth/ 2>/dev/null)" ] || [ "$(bluetoothctl show 2>/dev/null | grep 'Powered: yes')" = "" ]; then echo ">B🔴 OFF     "; else CONN_MAC=$(bluetoothctl devices Connected 2>/dev/null | awk '{print $2}' | head -n1); if [ -z "$CONN_MAC" ]; then echo ">B🟢 Not Conn"; else DEVICE=$(bluetoothctl info "$CONN_MAC" 2>/dev/null | grep "Name:" | cut -d' ' -f2- | cut -c 1-8); echo ">B🟢 $DEVICE"; fi; fi
execp_interval = 4
execp_has_icon = 0
execp_font = JetBrains Mono 8
execp_font_color = #000000 100
execp_padding = 8 0
execp_tooltip = 
execp_lclick_command = blueman-manager

# --- E: Indicator Network ---
execp = new
execp_command = CON_TYPE=$(nmcli -t -f TYPE,STATE dev | grep -w "connected" | head -n1 | cut -d: -f1); if [ "$CON_TYPE" = "ethernet" ]; then echo "🌐🟢 Wired        "; elif [ "$CON_TYPE" = "wifi" ]; then WIFI_INFO=$(nmcli -t -f active,ssid,signal dev wifi | grep '^yes:'); SSID=$(echo "$WIFI_INFO" | cut -d: -f2 | cut -c 1-8); SSID_PAD=$(printf "%-8s" "$SSID"); SIG=$(echo "$WIFI_INFO" | cut -d: -f3); SIG_PAD=$(printf "%3d" "$SIG"); echo "🛜🟢 $SSID_PAD $SIG_PAD%"; else echo "🌐🔴 Not Conn     "; fi
execp_interval = 5
execp_has_icon = 0
execp_font = JetBrains Mono 8
execp_font_color = #000000 100
execp_padding = 8 0
execp_tooltip = 
execp_lclick_command = lxterminal -e nmtui

# --- E: Separator ---
execp = new
execp_command = echo "|"
execp_interval = 0
execp_has_icon = 0
execp_font = JetBrains Mono 8
execp_font_color = #dcdcdc 100
execp_padding = 0 0
execp_tooltip = 

# --- E: Indicator Video Input ---
execp = new
execp_command = if [ -f /sys/class/video4linux/video0/device/power/runtime_status ]; then STATUS=$(cat /sys/class/video4linux/video0/device/power/runtime_status); if [ "$STATUS" = "active" ]; then echo "📷🟢 ON "; else echo "📷🔴 OFF"; fi; else echo "📷🔴 OFF"; fi
execp_interval = 2
execp_has_icon = 0
execp_font = JetBrains Mono 8
execp_font_color = #000000 100
execp_padding = 8 0
execp_tooltip = 

# --- E: Indicator Audio Input ---
execp = new
execp_command = MIC_MUTE=$(pactl get-source-mute @DEFAULT_SOURCE@ | awk '{print $2}'); if [ "$MIC_MUTE" = "yes" ]; then echo "🎤🔴 OFF "; else MIC_VOL=$(pactl get-source-volume @DEFAULT_SOURCE@ | awk '{print $5}' | head -n1 | tr -d '%'); MIC_PAD=$(printf "%3d" "$MIC_VOL"); echo "🎤🟢 $MIC_PAD%"; fi
execp_interval = 1
execp_has_icon = 0
execp_font = JetBrains Mono 8
execp_font_color = #000000 100
execp_padding = 8 0
execp_tooltip = 
execp_lclick_command = lxterminal -e alsamixer

