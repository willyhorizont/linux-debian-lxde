{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "color": {
            "title": "#00ADD8",
            "keys": "#FF1493",
            "output": "#CCFF00",
        }
    },
    "logo": {
        "color": {
            // "8": "#000000", // 30 // black
            "1": "#00ADD8", // 31 // red
            "2": "#FF1493", // 32 // green
            "3": "#00ADD8", // 33 // yellow
            "4": "#CCFF00", // 34 // blue
            "5": "#CCFF00", // 35 // magenta
            "6": "#FF1493", // 36 // cyan
            "7": "#CCFF00", // 37 // white
            // "9": "#FFFFFF", // reset
        }
    },
    "modules": [
        "title",
        "separator",

        {
            "key": "Name",
            "type": "host",
            // !!! customize here !!!
            "format": "(2012) Lenovo ThinkPad T430s i7 non-Nvidia",
            // "format": "(2021) Lenovo ThinkPad T14 Gen 2 AMD 5850U 16GB Soldered RAM",
        },

        // !!! customize here !!!
        {
            "key": "CPU",
            "type": "cpu",
            "format": "Intel Core i7-3520M, 3th Gen \"Ivy Bridge-M\", 22nm",
            // "format": "AMD Ryzen 7 5850U, Zen 3 / GCN5 based \"Cezanne-U\", TSMC 7nm",
        },
        {
            "key": " ",
            "type": "cpu",
            "format": "     2.9 — 3.6GHz, 2 Cores, 4 Threads, 4MB Cache, 35W TDP",
            // "format": "     1.9 – 4.4GHz, 8 Cores, 16 Threads, 20MB Cache, 15W TDP",
        },

        // !!! customize here !!!
        {
            "key": "GPU Integrated",
            "type": "gpu",
            "format": "Intel HD Graphics 4000",
            // "format": "AMD Radeon Vega 8",
        },
        {
            "key": "GPU Dedicated",
            "type": "custom",
            "format": "None"
        },

        // !!! customize here !!!
        {
            "key": "RAM",
            "type": "custom",
            "format": "16GB DDR3-1600 (8GB SO-DIMM + 8GB SO-DIMM)",
            // "format": "32GB DDR4-3200 (16GB Soldered + 16GB SO-DIMM)",
        },

        // !!! customize here !!!
        {
            "key": "Storage",
            "type": "custom",
            "format": "256GB SSD 2.5inch SATA",
            // "format": "1TB SSD M.2 2280 PCIe NVMe",
        },

        // !!! customize here !!!
        {
            "key": "OS",
            "type": "custom",
            "format": "Linux Debian LXDE",
        },

        {
            "key": "Distro",
            "type": "os"
        },

        {
            "key": "Desktop Environment",
            "type": "de"
        },

        "kernel",
        {
            "type": "shell",
            "format": "bash"
        },

        {
            "key": "Swap Partition",
            "type": "swap",
            "format": "{2}"
        },

        {
            "key": "Boot Manager",
            "type": "bootmgr",
            "format": "{1}"
        },

        "initsystem",

        {
            "key": "Display Manager",
            "type": "lm"
        },

        {
            "key": "Window Manager",
            "type": "wm"
        },

        {
            "key": "Terminal Emulator",
            "type": "terminal",
            "format": "lxterminal",
            // "format": "alacritty",
        },
        {
            "key": "Uptime",
            "type": "uptime"
        },

        {
            "type": "custom",
            "key": " ",
            "format": "{##F1E05A}███{#}{##3572A5}███{#}{##4F5D95}███{#}{##00ADD8}███{#}{##0298C3}███{#}{##A270BA}███{#}{##000080}███{#}{##701516}███{#}{##198CE7}███{#}{##A97BFF}███{#}{##F05138}███{#}{##00B4AB}███{#}{##945DB7}███{#}{##178600}███{#}{##E16737}███{#}{##DD1100}███{#}{##0000FB}███{#}{##C22D40}███{#}{##B07219}███{#}",
        },
        {
            "type": "custom",
            "key": " ",
            "format": "{##C9DF40}███{#}{##55BB55}███{#}{##199F4B}███{#}{##DEA584}███{#}{##7E7EFF}███{#}{##E4CC98}███{#}{##355570}███{#}{##239DAD}███{#}{##012456}███{#}{##6E4A7E}███{#}{##EF7A08}███{#}{##B83998}███{#}{##FFAFF3}███{#}{##EC915C}███{#}{##FFC200}███{#}{##60AFFE}███{#}{##F34B7D}███{#}{##438EFF}███{#}{##596706}███{#}",
        },
        {
            "type": "custom",
            "key": " ",
            "format": "{##882B0F}███{#}{##4298B8}███{#}{##00868B}███{#}{##2563EB}███{#}{##555555}███{#}{##BA595E}███{#}{##4F87C4}███{#}{##A56DE2}███{#}{##000100}███{#}{##383838}███{#}{##005390}███{#}"
        }
    ]
}
