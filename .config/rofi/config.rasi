configuration {
    timeout {
        action: "kb-cancel";
        delay:  0;
    }
    modes: "drun";
    font: "JetBrains Mono 8";
    show-icons: true;
    icon-theme: "Papirus";
    matching: "fuzzy";
    hover-select: false;
    disable-history: true;
    sort: false;
}
window {
    background-color: #000000;
    border-color:     #FF1493;
    border:           2px;
    padding:          0px;
    margin:           0px;
}
mainbox {
    background-color: transparent;
    children:         [ inputbar, listview ];
    padding:          0px;
    margin:           0px;
}
inputbar {
    background-color: transparent;
    text-color:       #CCFF00;
    orientation:      vertical;
    children:         [ promptbox, entrybox ];
    border:           0px;
    padding:          0px;
    margin:           0px;
}
promptbox {
    orientation:      horizontal;
    background-color: transparent;
    expand:           true;
    children:         [ prompt ];
    padding:          6px 0px;
    margin:           0px;
    border:           0px;
}
prompt {
    background-color: transparent;
    text-color:       #FF1493;
    str:              "";
    padding:          0px;
    margin:           2px 8px 0px 8px;
}
entrybox {
    orientation:      horizontal;
    background-color: transparent;
    children:         [ entry, num-filtered-rows, textbox-num-rows, num-rows ];
    border:           2px solid 0px 2px dash 0px;
    border-color:     #FF1493;
    padding:          6px 8px;
    margin:           0px;
}
entry {
    placeholder:       "Search";
    placeholder-color: #666666;
    background-color:  transparent;
    text-color:        #CCFF00;
    padding:           0px;
    margin:            0px;
}
element {
    padding:          4px 6px; 
    margin:           0px;
}
element normal.normal {
    background-color: #000000;
    text-color:       #CCFF00;
}
element alternate.normal {
    background-color: #000000;
    text-color:       #CCFF00;
}
element selected.normal {
    background-color: #00ADD8;
    text-color:       #000000;
}
element-text {
    background-color: transparent;
    text-color:       inherit;
}
element-icon {
    background-color: transparent;
    text-color:       inherit;
    margin:           0px 6px 0px 0px;
}
num-filtered-rows {
    background-color: transparent;
    text-color:       #00ADD8;
}
num-rows {
    background-color: transparent;
    text-color:       #00ADD8;
}
textbox-num-rows {
    background-color: transparent;
    text-color:       #00ADD8;
    expand:           false;
    str:              "/";
}
listview {
    border:       0px; 
    padding:      8px;
    margin:       0px;
    scrollbar:    false;
    fixed-height: true;
}
scrollbar {
    handle-color:     #FF1493;
    background-color: #111111;
}
