configuration {
    timeout {
        action: "kb-cancel";
        delay:  0;
    }
    filebrowser {
        directories-first: true;
        sorting-method:    "name";
    }
    modes: "drun";
    font: "JetBrains Mono 8";
    show-icons: true;
    icon-theme: "Papirus";
    matching: "fuzzy";
    hover-select: false;
    disable-history: true;
    sort: false;

    /* ---
    scroll-method: 0;
    ml-row-up: "";
    ml-row-down: "";
    me-select-entry: "MousePrimary";
    me-accept-entry: "MouseDPrimary";
    --- */
}
window {
    background-color: #000000;
    border-color:     #FF1493;
    border:           2px;
}
mainbox {
    background-color: transparent;
    children:         [ inputbar, listview ];
}
inputbar {
    background-color: transparent;
    text-color:       #CCFF00;
    
    orientation:      vertical;
    children:         [ prompt, entry-box ];

    border:           0px;
    padding:          0px;
    margin:           0px 0px 0px 0px;
}
prompt {
    background-color: transparent;
    text-color:       #FF1493;
    str:              "";
    margin:           0px 0px 6px 0px;
}
entry-box {
    orientation:      horizontal;
    background-color: transparent;
    children:         [ entry, num-filtered-rows, textbox-num-rows, num-rows ];

    border:           2px solid 0px 2px dash 0px;
    border-color:     #FF1493;
    
    padding:          6px 0px;
    margin:           0px;
}
entry {
    placeholder:       "Search";
    placeholder-color: #666666;
    background-color:  transparent;
    text-color:        #CCFF00;
}
element normal.normal {
    background-color: #000000;
    text-color:       #CCFF00;
}
element alternate.normal {
    background-color: #000000;
    text-color:       #CCFF00;
}
element selected.normal {
    background-color: #FF1493;
    text-color:       #000000;
}
element-text {
    background-color: transparent;
    text-color:       inherit;
}
element-icon {
    background-color: transparent;
    text-color:       inherit;
}
num-filtered-rows {
    background-color: transparent;
    text-color:       #00ADD8;
}
num-rows {
    background-color: transparent;
    text-color:       #00ADD8;
}
textbox-num-rows {
    background-color: transparent;
    text-color:       #00ADD8;
    expand:           false;
    str:              "/";
}
listview {
    border:       0px; 
    padding:      6px 0px 0px 0px;
    scrollbar:    false;
}
scrollbar {
    /* ---
    width:            4px;
    border:           0;
    handle-width:     8px;
    --- */
    handle-color:     #FF1493;
    background-color: #111111;
}
