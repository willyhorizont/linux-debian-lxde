#---- willyhorizont.github.io tint2-top-bar configuration ----
# https://gitlab.com/o9000/tint2/wikis/Configure
# https://gitlab.com/o9000/tint2/blob/master/doc/tint2.md

rounded = 0
border_width = 0
background_color = #000000 100
border_color = #000000 100

rounded = 0
border_width = 1
background_color = #ffffff 100
border_color = #FF1493 100

panel_items = EFEFEE
panel_position = top center horizontal
panel_layer = top
panel_size = 100% 20
panel_margin = 0 0
panel_padding = 0 0
panel_background_id = 1
strut_policy = follow_size
panel_window_name = tint2-top-bar

# --- E: SPRM ---
execp = new
execp_command = $HOME/willyhorizont.github.io/linux/SPRM-c
# execp_command = $HOME/willyhorizont.github.io/linux/SPRM-cpp
# execp_command = $HOME/willyhorizont.github.io/linux/SPRM.awk
