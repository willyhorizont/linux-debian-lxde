# execp_command = $HOME/willyhorizont.github.io/linux/SPRM.py
# execp_command = $HOME/willyhorizont.github.io/linux/SPRM.sh
execp_interval = 1
execp_has_icon = 0
execp_font = JetBrains Mono 8
execp_font_color = #FF1493 100
execp_padding = 0 0
execp_lclick_command = xterm -geometry 80x28 -bg black -fg white -fa Monospace -fs 8 -e btop

