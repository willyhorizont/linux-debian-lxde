#---- willyhorizont.github.io tint2-top-bar configuration ----
# https://gitlab.com/o9000/tint2/wikis/Configure
# https://gitlab.com/o9000/tint2/blob/master/doc/tint2.md

rounded = 0
border_width = 0
background_color = #000000 100
border_color = #000000 100

rounded = 0
border_width = 1
background_color = #000000 100
border_color = #FF1493 100

panel_items = EEFEFEE
panel_position = top center horizontal
panel_layer = top
panel_size = 100% 16
panel_margin = 0 0
panel_padding = 0 0
panel_background_id = 1
strut_policy = follow_size
panel_window_name = tint2-top-bar

# --- E: SPRM ---
execp = new
execp_command = $HOME/willyhorizont.github.io/linux/SPRM-c --pango --suff ' |'
# execp_command = $HOME/willyhorizont.github.io/linux/SPRM-cpp --pango --suff ' |'
# execp_command = $HOME/willyhorizont.github.io/linux/SPRM.awk --pango --suff ' |'
# execp_command = $HOME/willyhorizont.github.io/linux/SPRM.pl --pango --suff ' |'
# execp_command = $HOME/willyhorizont.github.io/linux/SPRM.py --pango --suff ' |'
# execp_command = $HOME/willyhorizont.github.io/linux/SPRM.sh --pango --suff ' |'
execp_interval = 1
execp_has_icon = 0
execp_font = JetBrains Mono 6
execp_font_color = #FF1493 100
execp_padding = 0 0
execp_lclick_command = lxterminal --geometry=88x28 --working-directory=~ -e btop
execp_markup = 1

