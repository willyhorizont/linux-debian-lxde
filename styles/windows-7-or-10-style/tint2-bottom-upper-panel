# --- E: Indicator Tux ---
execp = new
execp_command = ~/willyhorizont.github.io/linux/tux-indctr.sh
execp_interval = 2
execp_has_icon = 0
execp_font = JetBrains Mono 8
execp_font_color = #000000 100
execp_background_id = 1
execp_padding = 0 0
execp_lclick_command = lxterminal --geometry=88x28 --working-directory=~ -e ~/willyhorizont.github.io/linux/screensavr-mgr.sh

