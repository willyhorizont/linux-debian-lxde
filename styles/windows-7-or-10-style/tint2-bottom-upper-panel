rounded = 0
border_width = 0
background_color = #ffffff 100
border_color = #ffffff 100

rounded = 0
border_width = 1
background_color = #000000 100
border_color = #FF1493 100

panel_items = FSEEEEEEE
panel_position = bottom right horizontal
panel_layer = bottom
panel_size = 97% 18
panel_shrink = 0
panel_margin = 0 18
panel_padding = 0 0
panel_background_id = 1
wm_menu = 1
strut_policy = follow_size
panel_window_name = tint2-bottom-upper-panel

