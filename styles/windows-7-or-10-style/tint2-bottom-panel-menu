#---- willyhorizont.github.io tint2-bottom-panel-menu configuration ----
# https://gitlab.com/o9000/tint2/wikis/Configure
# https://gitlab.com/o9000/tint2/blob/master/doc/tint2.md

rounded = 0
border_width = 0
background_color = #ffffff 100
border_color = #ffffff 100

rounded = 0
border_width = 1
background_color = #000000 100
border_color = #FF1493 100

rounded = 0
border_width = 0
background_color = #000000 100
border_color = #000000 100

# panel_items = PF
panel_items = PEEEEEEEEF
panel_position = bottom left horizontal
panel_layer = bottom
panel_size = 50% 36
panel_shrink = 0
panel_margin = 0 0
panel_padding = 0 0
panel_background_id = 1
wm_menu = 0
strut_policy = follow_size
panel_window_name = tint2-bottom-panel-menu

# --- P: Bottom Panel App Launcher ---
button = new
button_text = 
button_font = JetBrains Mono Bold 8
button_font_color = #000000 100
button_icon = distributor-logo-debian
button_max_icon_size = 32
button_background_id = 3
button_lclick_command = sh -c 'env XDG_CURRENT_DESKTOP="$DESKTOP_SESSION" rofi -modi "Apps:$HOME/willyhorizont.github.io/linux-debian-lxde/rofi-manage-apps.sh" -show Apps -theme-str "configuration { location: 7; yoffset: -36; xoffset: 0; } window { width: 360px; }"'
button_padding = 2 0
button_tooltip = rofi Windows Start Menu / Mac Launchpad

# --- E: Windows Task View / Mac Mission Control / Linux rofi ---
execp = new
execp_command = ~/willyhorizont.github.io/linux-debian-lxde/rofi-fav-apps.sh --flip --indicator
execp_interval = 0
execp_continuous = 2
execp_has_icon = 1
execp_icon_w = 32
execp_markup = 1
execp_font = JetBrains Mono Bold 8
execp_font_color = #000000 100
execp_background_id = 1
execp_padding = 2 0
execp_lclick_command = ~/willyhorizont.github.io/linux/rofi-windows-task-view-mac-mission-control.sh

