# --- E: Indicator Workspace ---
execp = new
execp_command = ~/willyhorizont.github.io/linux/wrkspc-indctr.sh --rev --pango
execp_interval = 0
execp_has_icon = 0
execp_continuous = 1
execp_font = JetBrains Mono Bold 9
execp_font_color = #000000 100
execp_background_id = 1
execp_padding = 0 0
execp_lclick_command = ~/willyhorizont.github.io/linux/wrkspc-mgr.sh --goto
execp_markup = 1

# --- E: Button to Show Notification History ---
execp = new
execp_command = echo '| 🔔 '
execp_interval = 0
execp_has_icon = 0
execp_font = JetBrains Mono Bold 9
execp_font_color = #000000 100
execp_background_id = 1
execp_padding = 0 0
execp_lclick_command = dunstctl history-pop
execp_tooltip = Notification History

# --- E: Button Toggle Show Desktop ---
execp = new
execp_command = echo '| _ '
execp_interval = 0
execp_has_icon = 0
execp_font = JetBrains Mono Bold 9
execp_font_color = #000000 100
execp_background_id = 1
execp_padding = 0 0
execp_lclick_command = xdotool key ctrl+super+d
execp_tooltip = Toggle Show Desktop

tooltip_font_color = #CCFF00 100
tooltip_font = JetBrains Mono Bold 8
tooltip_background_id = 2
