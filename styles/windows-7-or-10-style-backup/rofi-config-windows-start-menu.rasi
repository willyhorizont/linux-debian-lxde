configuration {
    timeout {
        action: "kb-cancel";
        delay:  0;
    }
    filebrowser {
        directories-first: true;
        sorting-method:    "name";
    }
    modes: "drun";
    font: "JetBrains Mono 8";
    show-icons: true;
    icon-theme: "Papirus";
    matching: "fuzzy";
    hover-select: false;
    disable-history: true;
    sort: false;

    location: 7;
    yoffset:  -36;
    xoffset:  0;

    /* ---
    scroll-method: 0;
    ml-row-up: "";
    ml-row-down: "";
    me-select-entry: "MousePrimary";
    me-accept-entry: "MouseDPrimary";
    --- */
}
window {
    background-color: #000000;
    border-color:     #FF1493;
    border:           2px;
    width:            360px;
    height:           320px;
}
inputbar {
    background-color: transparent;
    text-color:       #CCFF00;
}
prompt {
    background-color: transparent;
    text-color:       #FF1493;
    margin:           0px 0.3em 0px 0px;
}
entry {
    background-color: transparent;
    text-color:       #CCFF00;
}
element normal.normal {
    background-color: #000000;
    text-color:       #CCFF00;
}
element alternate.normal {
    background-color: #000000;
    text-color:       #CCFF00;
}
element selected.normal {
    background-color: #FF1493;
    text-color:       #000000;
}
element-text {
    background-color: transparent;
    text-color:       inherit;
}
element-icon {
    background-color: transparent;
    text-color:       inherit;
}
num-filtered-rows {
    background-color: transparent;
    text-color:       #00ADD8;
}
num-rows {
    background-color: transparent;
    text-color:       #00ADD8;
}
textbox-num-rows {
    background-color: transparent;
    text-color:       #00ADD8;
}
listview {
    border:       2px dash 0px 0px; 
    border-color: #FF1493;

    scrollbar:    false;
}
entry {
    placeholder:       "Search";
    placeholder-color: #555555;
}
scrollbar {
    /* ---
    width:            4px;
    border:           0;
    handle-width:     8px;
    --- */
    handle-color:     #FF1493;
    background-color: #111111;
}
