#---- willyhorizont.github.io tint2-bottom-panel configuration ----
# https://gitlab.com/o9000/tint2/wikis/Configure
# https://gitlab.com/o9000/tint2/blob/master/doc/tint2.md

rounded = 0
border_width = 0
background_color = #ffffff 100
border_color = #ffffff 100

rounded = 0
border_width = 1
background_color = #ffffff 100
border_color = #FF1493 100

panel_items = PFSEEEEEEEEPEP
panel_position = bottom center horizontal
panel_layer = bottom
panel_size = 100% 36
panel_margin = 0 0
panel_padding = 0 0
panel_background_id = 1
wm_menu = 1
strut_policy = follow_window

# --- P: Bottom Panel App Launcher ---
button = new
button_text =  
button_font = JetBrains Mono Bold 8
button_font_color = #000000 100
button_background_id = 1
button_lclick_command = jgmenu_run
button_padding = 0 0

# --- S: Systray ---
systray_padding = 1 2
systray_background_id = 1
systray_sort = descending
systray_icon_size = 20
systray_icon_asb = 100 0 -80

# --- E: Indicator Tux ---
execp = new
execp_command = ~/willyhorizont.github.io/linux/indic0-tux.sh
