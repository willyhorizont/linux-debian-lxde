execp_has_icon = 0
execp_font = JetBrains Mono 11
execp_font_color = #000000 100
execp_background_id = 1
execp_padding = 0 0
execp_lclick_command = lxterminal -e ~/willyhorizont.github.io/linux/tui0-tux.sh

